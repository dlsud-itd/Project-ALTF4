# ==============================================================================
# ClinicQueue Monorepo - Environment Configuration Example
# Copy this file to .env for local development: cp .env.example .env
# IMPORTANT: Never commit actual secret keys or production credentials to Git.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend Server Listening Port (Default: 3000 locally, 10000 on Render)
PORT=3000

# ------------------------------------------------------------------------------
# Database Configuration (Hosted Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Pooled transaction connection string (e.g., Supabase port 6543 / PgBouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Direct session connection string for Prisma migrations (e.g., Supabase port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Authentication (JWT & Argon2)
# ------------------------------------------------------------------------------
# Secret key for signing JSON Web Tokens (Use a high-entropy 256-bit random string in production)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-for-production"

# JWT token expiration window
JWT_EXPIRES_IN="1d"

# ------------------------------------------------------------------------------
# CORS Origins (Comma-separated allowed origins)
# ------------------------------------------------------------------------------
# Local development and production Vercel frontend URL
CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200,https://clinicqueue.vercel.app"

# ------------------------------------------------------------------------------
# Public Frontend Configuration (Used by Angular web application)
# ------------------------------------------------------------------------------
# Local: http://localhost:3000/api/v1
# Render Production: https://clinicqueue-api.onrender.com/api/v1
PUBLIC_API_URL="http://localhost:3000/api/v1"
PUBLIC_WS_URL="http://localhost:3000"
