{
  "name": "clinicqueue-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ClinicQueue Monorepo - Angular frontend on Vercel, NestJS API on Render, PostgreSQL on Supabase",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=web run start",
    "dev:api": "npm --workspace=api run start:dev",
    "build:web": "npm --workspace=web run build",
    "build:api": "npm --workspace=api run build",
    "build": "npm run prisma:generate && npm run build:api && npm run build:web",
    "lint": "npm --workspace=api run lint",
    "test": "npm --workspace=api run test",
    "test:e2e": "playwright test",
    "prisma:generate": "npm --workspace=api run prisma:generate",
    "prisma:migrate:dev": "npm --workspace=api run prisma:migrate:dev",
    "prisma:migrate:deploy": "npm --workspace=api run prisma:migrate:deploy",
    "prisma:seed": "npm --workspace=api run prisma:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
